{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["bun", "google.maps"],
    "paths": {
      "$shared/*": ["./shared/*"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "server/**/*.ts",
    "bot-tools/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "playwright.config.ts",
    "web/tests/**/*.ts",
    "web/src/**/*.test.ts",
    "web/src/i18n/format.ts",
    "web/src/i18n/ru.ts",
    "web/src/lib/clock.ts",
    "web/src/lib/detective-format.ts",
    "web/src/lib/journal-format.ts",
    "web/src/lib/play-style.ts",
    "web/src/lib/price.ts",
    "web/src/lib/region-options.ts",
    "web/src/lib/audio-catalog.ts",
    "web/src/lib/audio-director.ts",
    "web/src/lib/audio-player.ts",
    "web/src/lib/audio-profile-sync.ts",
    "web/src/lib/audio-preferences.ts",
    "web/src/lib/profile.ts",
    "web/src/lib/orbit/spin.ts",
    "web/src/lib/orbit/pose.ts",
    "web/src/lib/orbit/framing.ts",
    "web/src/lib/orbit/types.ts",
    "web/src/lib/map-load-reports.ts",
    "web/src/lib/maps-loader.ts",
    "web/src/lib/fake-canvas.ts"
  ]
}
